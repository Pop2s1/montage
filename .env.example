# Environment variables for Montage
# Copy to .env and adjust values.

# Database — PostgreSQL (required for Vercel; local Docker/apt Postgres also fine)
DATABASE_URL="postgresql://montage:montage@127.0.0.1:5432/montage"

# Auth.js / NextAuth
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"
# Optional: NEXTAUTH_URL="http://localhost:3000"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Storage
STORAGE_DRIVER="local" # local | s3
STORAGE_LOCAL_ROOT="./storage"
# S3 (optional)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Providers
TRANSCRIPTION_PROVIDER="demo" # demo | openai
MONTAGE_PROVIDER="demo"       # demo | openai
# OPENAI_API_KEY=

# Limits (defaults; also stored per user)
MAX_UPLOAD_BYTES=524288000
MAX_VIDEO_DURATION_SEC=1800
ALLOWED_VIDEO_MIME="video/mp4,video/webm,video/quicktime"

# Worker
WORKER_POLL_MS=1500
WORKER_CONCURRENCY=1

# Download links TTL (seconds)
DOWNLOAD_TOKEN_TTL_SEC=3600

# Vercel Blob (required for phone videos > 4MB on Vercel)
# BLOB_READ_WRITE_TOKEN=

