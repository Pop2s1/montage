{
  "name": "montage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "next dev --turbopack --port 3000",
    "build": "node scripts/build.js",
    "postinstall": "node scripts/ensure-db-url.js --allow-placeholder && prisma generate",
    "db:generate": "node scripts/ensure-db-url.js --allow-placeholder && prisma generate",
    "db:migrate": "node scripts/ensure-db-url.js && prisma migrate deploy",
    "db:migrate:dev": "node scripts/ensure-db-url.js && prisma migrate dev",
    "db:push": "node scripts/ensure-db-url.js && prisma db push",
    "db:seed": "node scripts/ensure-db-url.js && tsx prisma/seed.ts",
    "db:studio": "node scripts/ensure-db-url.js && prisma studio",
    "worker": "tsx src/workers/index.ts"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/functions": "^3.7.5",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "nanoid": "^6.0.0",
    "next": "15.5.20",
    "next-auth": "5.0.0-beta.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "ffmpeg-static",
      "@ffmpeg-installer/ffmpeg"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
